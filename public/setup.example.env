# Cloudflare Admin Toolkit — 설치 설정
#
#   1) 이 파일을 소스 폴더에 setup.env 로 저장
#   2) 아래 빈 칸을 채우고
#   3) node setup.mjs          (먼저 확인만 하려면 node setup.mjs --dry-run)
#
# 다시 실행하면 새로 만들지 않고 업데이트합니다. 값을 고친 뒤 한 번 더 실행하면 됩니다.
# 소스 폴더의 wrangler.jsonc 는 건드리지 않습니다. 설치용 설정은 wrangler.setup.jsonc 에 따로 만듭니다.

# ── Worker ──────────────────────────────────────────────
# Worker 이름 (영문 소문자 · 숫자 · -). 주소 = <이름>.<서브도메인>.workers.dev          [필수]
WORKER_NAME=
# Worker 를 둘 Cloudflare 계정 ID. wrangler 로그인 계정이 하나면 비워 둬도 됨
ACCOUNT_ID=
# 붙일 도메인 (예: admin.example.com). Worker 와 같은 계정의 도메인만. 없으면 비워 둠
CUSTOM_DOMAIN=

# ── 시크릿 — 올린 뒤 이 파일에서 자동으로 지워집니다 ──────────
# 다시 실행할 때 비워 두면 이미 올린 값을 그대로 씁니다.
# 도메인 토큰 (Zone Read · DNS Edit · Zone Settings Edit · Cache Rules Edit)          [처음엔 필수]
CF_API_TOKEN=
# IP Rules 토큰 (Account Firewall Access Rules Edit · Firewall Services Edit · Zone Read). 없으면 CF_API_TOKEN 을 씀
CF_IP_TOKEN=
# 로그인 비밀번호 앞부분. 실제 비밀번호 = 이 값 + ! + 오늘 날짜 두 자리 (한국 시간)      [처음엔 필수]
PASSWORD_PREFIX=
# (SESSION_SECRET 은 자동으로 만듭니다)

# ── 변수 — (설정) 표시는 배포 뒤 설정 메뉴에서도 바꿀 수 있음 ────
# DNS · SSL/TLS 일괄 변경 대상 서버 IP                                                   [필수] (설정)
SERVER_IP=
# 처음 보이는 그룹 탭. 그룹이 없으면 비워 둠                                              (설정)
DEFAULT_GROUP=
# 404 가드가 Allow 예외 룰을 만드는 자산존 도메인. 쓰지 않으면 비워 둠                    (설정)
IP_PAIR_ZONE_NAME=
# 구글 OTP 앱에 보이는 이름. 비우면 CF Admin                                              (설정)
OTP_ISSUER=
# 도메인 상태 캐시 시간(분). 비우면 10                                                    (설정)
CACHE_TTL_MINUTES=
# IP Rules 5분 호출 상한. 비우면 900                                                      (설정)
IP_RATE_BUDGET=
# Cloudflare API 동시 호출 수. 비우면 6
CONCURRENCY=
# 변경 요청 한 번에 넣는 도메인 수. 비우면 5 (무료 요금제 권장값)
MAX_ZONES_PER_CALL=
# IP Rules 계정 ID. 보통 비워 둠 (토큰으로 자동으로 찾음)
IP_ACCOUNT_ID=
